APP_NAME="Torre Tórò"
APP_ENV=production
APP_KEY=base64:CkQVc+SBdahPtFoe4ShwTmNck+RQ3bB6dW5LxEm263Y=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- cPanel MySQL Database Details ---
# Note: On cPanel, databases and users are typically prefixed with your cPanel username (e.g. cpaneluser_dbname)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_toretorro
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_cpanel_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.torretoro.com
MAIL_PORT=465
MAIL_USERNAME=hello@torretoro.com
MAIL_PASSWORD="Restricted99@"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@torretoro.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_RECIPIENT="kater@torretoro.com"
